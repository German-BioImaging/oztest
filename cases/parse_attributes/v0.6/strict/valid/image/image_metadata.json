{
  "_conformance": {
    "schema": {
      "id": "schemas/strict_image.schema"
    },
    "strict": true
  },
  "ome": {
    "@id": "top",
    "@type": "ngff:Image",
    "multiscales": [
      {
        "@id": "inner",
        "coordinateSystems": [
          {
            "axes": [
              {
                "name": "y",
                "type": "space",
                "unit": "micrometer"
              },
              {
                "name": "x",
                "type": "space",
                "unit": "micrometer"
              }
            ],
            "name": "physical"
          }
        ],
        "datasets": [
          {
            "coordinateTransformations": [
              {
                "input": {
                  "path": "path/to/0"
                },
                "output": {
                  "name": "physical"
                },
                "scale": [
                  1,
                  1
                ],
                "type": "scale"
              }
            ],
            "path": "path/to/0"
          }
        ],
        "metadata": {
          "args": [
            "true",
            "false"
          ],
          "kwargs": {
            "multichannel": true
          },
          "method": "skimage.transform.pyramid_gaussian",
          "version": "0.16.1"
        },
        "name": "example",
        "type": "gaussian"
      }
    ],
    "version": "0.6rc0"
  }
}
